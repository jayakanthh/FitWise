rules_version = '2';

// IronSync Firestore Security Rules
// Owner: jaikanth (backend). These rules are the REAL protection for our data —
// the client can't be trusted, so access control lives here.
//
// Golden rules:
//  - A user's profile, measurements, and HEALTH NOTES are private to that user.
//  - Health data must NEVER be readable by the friend group.
//  - Only explicitly-shared data (group PRs, streak board, supplement posts) is group-visible.
//
// This is a starting point — tighten as features land. Test with the Firebase emulator.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ---- Users & their PRIVATE sub-collections ----
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Measurements & health notes: owner-only, no exceptions.
      match /measurements/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /healthNotes/{docId} {
        allow read, write: if isOwner(userId);
      }
      // Workouts, PRs, nutrition: owner-only for now.
      match /{sub}/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ---- Shared exercise library: everyone signed-in reads; users add their own customs ----
    // (Seeded exercises are written via the Admin SDK / CLI, which bypasses these rules.)
    match /exercises/{exerciseId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.isCustom == true
                    && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    // ---- Training plans: public plans are readable by all; private only by owner ----
    match /plans/{planId} {
      allow read: if isSignedIn()
                  && (resource.data.visibility == 'public'
                      || resource.data.createdBy == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    // ---- Friends (1-to-1) ----
    // Requests: sender creates; either party can read/delete (accept/decline).
    match /friendRequests/{reqId} {
      allow read, delete: if isSignedIn()
                          && (request.auth.uid == resource.data.fromId
                              || request.auth.uid == resource.data.toId);
      allow create: if isSignedIn() && request.resource.data.fromId == request.auth.uid;
    }
    // Friendships: keyed by sorted pair; either member can read/write/delete.
    // ⚠️ Add-by-email currently queries the users collection (owner-only reads),
    //    which works in test mode. For production, look users up via a Cloud
    //    Function or a minimal public-profiles collection instead.
    match /friendships/{pairId} {
      allow read, write: if isSignedIn() && request.auth.uid in resource.data.members;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.members;
    }

    // ---- Groups (crews) ----
    match /groups/{groupId} {
      // Readable by any signed-in user, so someone can look a crew up by invite code to join.
      allow read: if isSignedIn();
      // Create your own crew (you must be its creator and a member).
      allow create: if isSignedIn()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.auth.uid in request.resource.data.members;
      // Update: existing members can edit; a non-member may add THEMSELVES (join by code).
      // ⚠️ MVP TRADE-OFF: this lets a signed-in user add themselves to any groupId they know.
      // Harden on Blaze by moving "join" into a Cloud Function that verifies the invite code.
      allow update: if isSignedIn()
                    && (request.auth.uid in resource.data.members
                        || request.auth.uid in request.resource.data.members);
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      // Boards & supplement posts: members read; members write (client-side board sync on Spark).
      // ⚠️ On Blaze, tighten leaderboard/streakBoard `write` to `false` and let the
      //    Cloud Function (Admin SDK) own them — see backend/functions/.
      function isMember() {
        return isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
      }
      match /{sub}/{docId} {
        allow read, write: if isMember();
      }
    }
  }
}
